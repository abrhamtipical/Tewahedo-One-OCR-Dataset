[
  {
    "sortOder": 0,
    "text": "ኲሉ ፡ ዘኢያፈቅሮ ፡ ለእግዚእነ ፡ ወመድኃኒነ ፡ ኢየሱስ ፡ ክርስቶስ ፡ ወዘኢየአምን ፡ ልደቶ ፡ እማርያም ፡ እምቅድስት ፡ ድንግል ፡ በ፪ ፡ ታቦተ ፡ መንፈስ ፡ ቅዱስ ፡ እስከ ፡ ምጽአቱ ፡ ሐዳስ ፡ በከመ ፡ ይቤ ፡ ጳውሎስ ፡ ውጉዘ ፡ ለይኩን ።",
    "amh": "ጌታችንንና መድኃኒታችንን ኢየሱስ ክርስቶስን የማይወደው የመንፈስ ቅዱስ ማደሪያ በሁለት ወገን ድንግል ከምትሆን ከቅድስት ማርያም መወለዱን የማያምን ሰው ቢኖር እንግዳ እስከሚሆን ምጽአቱ ድረስ ቅዱስ ጳውሎስ እንደ ተናገረ የተለየ ይሁን።",
    "title": "መልእክተ ጳውሎስ",
    "turn": "ይ.ዲ.",
    "metadata": {
      "schemaVersion": 1,
      "source": "EOTC traditional liturgy",
      "language": "gez-am"
    }
