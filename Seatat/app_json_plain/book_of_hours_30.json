  {
    "sortOder": 6,
    "text": "የበዓላት ቅዳሴ። በበዓለ ሐዋርያት የሐዋርያት ቅደሴ። በበዓለ ወልድ በደብረ ታቦር በቍስቋም በሕንፀታ ወበቅዳሴ ቤታ ነሐሴ ፲፮ ቀን ቅዳሴ እግዚእ። በዘመነ ስብከት በጽጌ ወበፍሬ በሰማዕታት ወበነቢያት ጥር ፬ ቀን ኅቤከ (ወልደ ነጐድጓድ)። በረቡዕ ወበዓርብ በቅዳሜ፤ በመድኃኔ ዓለም፤ በመስቀል፤ ግንቦት ፲፪ ቀን ናሁ ንዜኑ። በበዓላተ ማርያም በአማኑኤል ጐሥዐ። በቃና ዘገሊላ በጻድቃን (በብዙኃን ማርያም) በ፬ እንስሳ በካህናተ ኅዳር ፱ ቀን ኅዳር ፳፬ ቀን ግሩም።",
    "title": "የበዓላት ቅዳሴ በበዓለ ሐዋርያት",
    "turn": "ሥርዓት",
    "metadata": {
      "schemaVersion": 1,
      "source": "Mets'hafe Se'atat (Aba Tume Lisan edition)",
      "language": "gez-am"
    }
  },
  {
    "sortOder": 7,
    "text": "በእሁድ በክረምት ግንቦት ፯ ቀን (ዕረፍቱ) አትናቴዎስ። በተዝካረ ጳጳሳት ወካህናት ወነገሥት አመ ፮ ለጥር ባስልዮስ። እምረቡ ኒቆዲሞስ እስከ ሆሣዕና ጥር ፳፩ ቀን (ዕረፍቱ) ጎርጎርዮስ። በጸሎተ ሐሙስ በጥምቀት ገሃድ፤ ግንቦት ፯ ቀን በክረምት እንዘ ታስተባሪ ምስለ አትናቴዎስ ኤጲፋንዮስ። በደብረ ዘይት በጳጕሜን በመላእክት ሰኔ ፯ ቀን ዕረፍቱ ተንሥኡ (ያዕቆብ)። በዘመነ ልደት፤ በጥምቀት፤ በትንሣኤ፤ በዕርገት፤ በበዓለ መንፈስ ቅዱስ፤ በሥላሴ መስከረም ፯ ቀን ዕረፍቱ እምቅድመ ዓለም። በልደት ካልእ ጎርጎርዮስ ቀድስ።",
    "title": "በእሁድ በክረምት ግንቦት ቀን",
    "turn": "ሥርዓት",
    "metadata": {
      "schemaVersion": 1,
      "source": "Mets'hafe Se'atat (Aba Tume Lisan edition)",
      "language": "gez-am"
    }
  },
  {
    "sortOder": 8,
    "text": "፱ቱ ንኡሳን በዓላት።",
    "title": "ቱ ንኡሳን በዓላት",
    "turn": "ሥርዓት",
    "metadata": {
      "schemaVersion": 1,
      "source": "Mets'hafe Se'atat (Aba Tume Lisan edition)",
      "language": "gez-am"
    }
  },
  {
    "sortOder": 9,
    "text": "መስቀል መስከረም ፲፯ ቀን። ስብከት፤ ብርሃን ኖላዊ፤ ጌና ታሕሣሥ ፳፰ ቀን፤ ግዝረት ጥር ፯ ቀን፤ በዓለ ስምዖን የካቲት ፰ ቀን፤ ደብረ ዘይ፤ መስቀል መጋቢት ፲ ቀን፤ መስቀልና መስቀል ፩ ወገን ቢሉ ፱ኛ ቃና ዘገሊላ ናቸው።",
    "title": "መስቀል መስከረም ቀን ስብከት",
    "turn": "ሥርዓት",
    "metadata": {
      "schemaVersion": 1,
      "source": "Mets'hafe Se'atat (Aba Tume Lisan edition)",
      "language": "gez-am"
    }
  },
  {
    "sortOder": 10,
    "text": "የ፲፪ ሐዋርያት በዓላት።",
    "title": "የ ሐዋርያት በዓላት",
    "turn": "ሥርዓት",
    "metadata": {
      "schemaVersion": 1,
      "source": "Mets'hafe Se'atat (Aba Tume Lisan edition)",
      "language": "gez-am"
    }
  },
  {
    "sortOder": 11,
    "text": "መስከረት ፩ ቀን በርተሎሚዎስ። ጥቅምት ፲፪ ቀን ማቴዎስ። ኅዳር ፲፰ ቀን ፊልጶስ። ታሕሣሥ ፬ ቀን እንድርያስ። ጥር ፬ ቀን ዮሐንስ። የካቲት ፲ ቀን ያዕቆብ ወልደ እልፍዮስ። መጋቢት ፰ ቀን ማትያስ። ሚያዝያ ፲፯ ቀን ያዕቆብ ወልደ ዘብዴዎስ። ግንቦት ፳፮ ቀን ቶማስ። ሐምሌ ፪ ቀን ታዴዎስ። ሐምሌ ፭ ቀን ጴጥሮስ ወጳውሎስ። ሐምሌ ፲ ቀን ናትናኤል። በዝየ ተፈጸመ ሰዓታት ዘደብር ዓባይ ምስለ ኵሉ ጸዊትዊሁ ስብሐት ለእግዚአብሔር። ዘአኅተሞ መምሕር ጥሀዑመ ልሳን ኪዳነ ማርያም ዘደብር ዓባይ አቡነ ሳሙኤል።",
    "title": "መስከረት ቀን በርተሎሚዎስ ጥቅምት",
    "turn": "ሥርዓት",
    "metadata": {
      "schemaVersion": 1,
